# Copy to .env — never commit the real one.
#
# Generate a key-pair at https://pro.kraken.com/app/settings/api
# (or app.kraken.com -> Settings -> API). "Enable" the API and note
# the public key and the private secret — the secret is shown once.

# Required for authenticated (private) endpoints. Public market data
# works without them.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional — override the REST/WebSocket endpoints (defaults match the
# public Kraken API; you normally never need these).
# KRAKEN_REST_URL=https://api.kraken.com
# KRAKEN_WS_URL=wss://ws.kraken.com/v2
# KRAKEN_WS_AUTH_URL=wss://ws-auth.kraken.com/v2

# Optional — minimum seconds between REST calls (polite rate limiting).
# Spot REST is limited to ~15-20 calls/s by tier. Set e.g. 0.08 for ~12/s.
# KRAKEN_MIN_INTERVAL=0.0

# ── Paper trading (no API key needed) ───────────────────────────────────
# KrakenManager.paper() / `kraken-python --paper` simulate an account over
# real market data.  Optional knobs, all with sensible defaults:

# Opening balance of the quote asset (default: 10000).
# KRAKEN_PAPER_BALANCE=10000

# Account quote currency (asset altname, default: USD).
# KRAKEN_PAPER_QUOTE=USD

# Fee rates applied to simulated fills.
# KRAKEN_PAPER_FEE_TAKER=0.0026
# KRAKEN_PAPER_FEE_MAKER=0.0016

# Fill trigger: "book" (top-of-book best bid/ask) or "last" (ticker last).
# KRAKEN_PAPER_PRICE=book

# JSON state file path to persist balances/orders/history between runs.
# Omit for a fresh in-memory account every run.
# KRAKEN_PAPER_STATE=./paper-state.json