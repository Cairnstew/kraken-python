# Copy to .env — never commit the real one.
#
# Generate a key-pair at https://pro.kraken.com/app/settings/api
# (or app.kraken.com -> Settings -> API). "Enable" the API and note
# the public key and the private secret — the secret is shown once.

# Required for authenticated (private) endpoints. Public market data
# works without them.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Optional — override the REST/WebSocket endpoints (defaults match the
# public Kraken API; you normally never need these).
# KRAKEN_REST_URL=https://api.kraken.com
# KRAKEN_WS_URL=wss://ws.kraken.com/v2
# KRAKEN_WS_AUTH_URL=wss://ws-auth.kraken.com/v2

# Optional — minimum seconds between REST calls (polite rate limiting).
# Spot REST is limited to ~15-20 calls/s by tier. Set e.g. 0.08 for ~12/s.
# KRAKEN_MIN_INTERVAL=0.0